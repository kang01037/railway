<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.railway.trainstock.mapper.StockFlowMapper">

    <resultMap id="BaseResultMap" type="com.railway.trainstock.entity.StockFlowDO">
        <id     column="id"          property="id"/>
        <result column="order_no"    property="orderNo"/>
        <result column="train_no"    property="trainNo"/>
        <result column="run_date"    property="runDate"/>
        <result column="seat_type"   property="seatType"/>
        <result column="delta"       property="delta"/>
        <result column="biz_type"    property="bizType"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, order_no, train_no, run_date, seat_type, delta, biz_type, create_time
    </sql>

    <insert id="insert" parameterType="com.railway.trainstock.entity.StockFlowDO">
        INSERT INTO stock_flow (
            id, order_no, train_no, run_date, seat_type, delta, biz_type, create_time
        ) VALUES (
            #{id}, #{orderNo}, #{trainNo}, #{runDate}, #{seatType}, #{delta}, #{bizType}, #{createTime}
        )
    </insert>

    <select id="listByOrderNo" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM stock_flow
        WHERE order_no = #{orderNo}
        ORDER BY create_time ASC, id ASC
    </select>

</mapper>
