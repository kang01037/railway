<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.railway.user.mapper.PassengerMapper">

    <resultMap id="BaseResultMap" type="com.railway.user.entity.PassengerDO">
        <id     column="id"              property="id"/>
        <result column="user_id"         property="userId"/>
        <result column="name"            property="name"/>
        <result column="id_card_type"    property="idCardType"/>
        <result column="id_card_no"      property="idCardNo"/>
        <result column="phone"           property="phone"/>
        <result column="passenger_type"  property="passengerType"/>
        <result column="is_default"      property="isDefault"/>
        <result column="create_time"     property="createTime"/>
        <result column="update_time"     property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, name, id_card_type, id_card_no, phone,
        passenger_type, is_default, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.railway.user.entity.PassengerDO"
            useGeneratedKeys="false">
        INSERT INTO passenger (
            id, user_id, name, id_card_type, id_card_no, phone,
            passenger_type, is_default, create_time, update_time
        ) VALUES (
            #{id}, #{userId}, #{name}, #{idCardType}, #{idCardNo}, #{phone},
            #{passengerType}, #{isDefault}, #{createTime}, #{updateTime}
        )
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM passenger
        WHERE id = #{id}
    </select>

    <select id="listByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM passenger
        WHERE user_id = #{userId}
        ORDER BY is_default DESC, create_time DESC
    </select>

    <update id="clearDefaultByUserId">
        UPDATE passenger
        SET is_default = 0
        WHERE user_id = #{userId}
    </update>

    <update id="updateById" parameterType="com.railway.user.entity.PassengerDO">
        UPDATE passenger
        <set>
            <if test="name           != null">name            = #{name},</if>
            <if test="idCardNo       != null">id_card_no       = #{idCardNo},</if>
            <if test="phone          != null">phone           = #{phone},</if>
            <if test="passengerType  != null">passenger_type  = #{passengerType},</if>
            <if test="isDefault      != null">is_default      = #{isDefault},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM passenger WHERE id = #{id}
    </delete>

    <select id="listByIds" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM passenger
        WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>

</mapper>
