<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.railway.user.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.railway.user.entity.UserDO">
        <id     column="id"         property="id"/>
        <result column="username"   property="username"/>
        <result column="password"   property="password"/>
        <result column="phone"      property="phone"/>
        <result column="email"      property="email"/>
        <result column="id_card"    property="idCard"/>
        <result column="real_name"  property="realName"/>
        <result column="user_type"  property="userType"/>
        <result column="status"     property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password, phone, email, id_card, real_name,
        user_type, status, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.railway.user.entity.UserDO">
        INSERT INTO `user` (
            id, username, password, phone, email, id_card, real_name,
            user_type, status, create_time, update_time
        ) VALUES (
            #{id}, #{username}, #{password}, #{phone}, #{email}, #{idCard}, #{realName},
            #{userType}, #{status}, #{createTime}, #{updateTime}
        )
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `user`
        WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `user`
        WHERE username = #{username}
        LIMIT 1
    </select>

    <update id="updateById" parameterType="com.railway.user.entity.UserDO">
        UPDATE `user`
        <set>
            <if test="phone     != null">phone      = #{phone},</if>
            <if test="email     != null">email      = #{email},</if>
            <if test="idCard    != null">id_card    = #{idCard},</if>
            <if test="realName  != null">real_name  = #{realName},</if>
            <if test="userType  != null">user_type  = #{userType},</if>
            <if test="status    != null">status     = #{status},</if>
            <if test="password  != null">password   = #{password},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `user` WHERE id = #{id}
    </delete>

    <select id="countByUsername" resultType="int">
        SELECT COUNT(*) FROM `user` WHERE username = #{username}
    </select>

</mapper>
